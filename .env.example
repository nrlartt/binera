# Public HTTPS origin behind a reverse proxy, e.g. https://binera.xyz.
# Server-only configuration; leave unset for local development.
APP_ORIGIN=
# Additional owned origin kept for existing domain-bound passkeys.
APP_ADDITIONAL_ORIGINS=https://binera.xyz,https://binera-production.up.railway.app
# Optional reviewed BSC registry identities, comma-separated.
# Unreachable/incompatible providers are excluded from the default research view.
# Starts with audited identities, then checks discovered endpoint candidates; up to 32 total.
MARKETPLACE_AGENT_IDS=
# Optional. Anonymous 8004scan access works with lower rate limits.
SCAN_API_KEY=
# Server-only authenticated RPC, if required. Defaults to public BSC RPC.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Optional OpenAI intent interpretation. Ranking is always deterministic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional deployed BNB Studio A2A cards. Comma-separated HTTPS URLs.
STUDIO_AGENT_URLS=
# Optional on-chain protocol addresses (see docs/contracts.md). Leave empty until
# audited contracts are deployed and independently reviewed.
BINERA_STAKE_ADDRESS=
BINERA_REPUTATION_ADDRESS=
BINERA_ARBITRATION_ADDRESS=
BINERA_BOUNTY_VAULT_ADDRESS=
BINERA_PAYMENT_TOKEN_ADDRESS=
# Optional. Enables POST /api/protocol/configure so a browser deployment can be
# activated without editing env or restarting. Use a long random value.
OPERATOR_TOKEN=
