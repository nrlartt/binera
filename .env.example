# Optional. Anonymous 8004scan access works with lower rate limits.
SCAN_API_KEY=
# Server-only authenticated RPC, if required. Defaults to public BSC RPC.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Optional OpenAI intent interpretation. Ranking is always deterministic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional deployed BNB Studio A2A cards. Comma-separated HTTPS URLs.
STUDIO_AGENT_URLS=
# Enable only after configuring a remote TermiX BSC MCP deployment.
TERMIX_MCP_URL=
TERMIX_MCP_TOKEN=
# Or use the official stdio server, e.g. node + ["/absolute/path/build/index.js"].
# Configure it outside the application; never use a user's signing wallet here.
TERMIX_COMMAND=
TERMIX_ARGS=[]
