# Copy this file to .env.local and fill the operator values.
# Never prefix secrets with NEXT_PUBLIC_.

# ----- Core -----
# Local: http://localhost:3000. Production: https://binera.xyz
APP_ORIGIN=
APP_ADDITIONAL_ORIGINS=
MARKETPLACE_AGENT_IDS=
SCAN_API_KEY=
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
STUDIO_AGENT_URLS=

# ----- Protocol deployment -----
# Funded deployer wallet for the selected network. Never reuse a treasury key.
DEPLOYER_PRIVATE_KEY=
# Optional separate mainnet deployer. Used only by --network bsc.
MAINNET_DEPLOYER_PRIVATE_KEY=
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
# Arbiter address. Use a multisig/timelock for production; the deployer is fine on testnet.
ARBITER_ADDRESS=
PAYMENT_TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# Usually filled by /protocol/deploy activation; env wins over the runtime file.
BINERA_STAKE_ADDRESS=
BINERA_REPUTATION_ADDRESS=
BINERA_ARBITRATION_ADDRESS=
BINERA_BOUNTY_VAULT_ADDRESS=
BINERA_PAYMENT_TOKEN_ADDRESS=
# Optional testnet/local RPC for protocol reads.
BINERA_PROTOCOL_RPC=
# Random value enabling POST /api/protocol/configure (32+ characters).
OPERATOR_TOKEN=
MARKETPLACE_DB_PATH=
# Optional outbound events. HTTPS only; signature is HMAC-SHA256 of the body.
EXCHANGE_WEBHOOK_URL=
EXCHANGE_WEBHOOK_SECRET=

# ----- Seller runtime -----
# Provider wallet registered on ERC-8004 (getAgentWallet).
SELLER_PRIVATE_KEY=
# Public HTTPS origin of the seller.
SELLER_BASE_URL=
SELLER_NAME=Binera reference seller
SELLER_PRICE=100000000000000000
SELLER_CURRENCY=0x55d398326f99059fF775485246999027B3197955
SELLER_PORT=4400
